ge":130},{"id":"P30B-evacuation","countries":["JPN"],"years":[1944,1944],"title":"学童疎開","text":"学校の仲間と親元を離れて疎開し、集団生活の中で学びと食事を続けました。","source":"evacuation","place":"東京|横浜|名古屋|大阪|神戸|京都|川崎|門司|若松|小倉|戸畑|八幡|長崎","heavy":false,"kind":"schoolEvac","minAge":8,"maxAge":11,"affected":400000},{"id":"P30B-labour","countries":["JPN"],"years":[1944,1945],"title":"学徒勤労動員","text":"授業を離れ、工場や作業場で働くことになりました。","source":"warSchool","place":"","heavy":false,"kind":"studentLabour","minAge":12,"maxAge":25},{"id":"P30B-womenLabour","countries":["JPN"],"years":[1944,1945],"title":"女子挺身勤労令","text":"未婚女性を労働力として動員する制度が広がりました。女子挺身隊は軍の慰安婦制度とは別の制度です。","source":"chronology","place":"","heavy":false,"kind":"womenLabour","minAge":14,"maxAge":24},{"id":"P30B-tokyoRaid","countries":["JPN"],"years":[1945,1945],"title":"東京大空襲","text":"東京への空襲と火災で生活の場を失い、避難しました。","source":"warCrimes","place":"東京","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-osakaRaid","countries":["JPN"],"years":[1945,1945],"title":"大阪への空襲","text":"大阪への空襲で街が焼け、住まいを離れました。","source":"chronology","place":"大阪","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-nagoyaRaid","countries":["JPN"],"years":[1945,1945],"title":"名古屋への空襲","text":"名古屋への空襲で街が焼け、住まいを離れました。","source":"chronology","place":"名古屋","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-kobeRaid","countries":["JPN"],"years":[1945,1945],"title":"神戸への空襲","text":"神戸への空襲で街が焼け、住まいを離れました。","source":"chronology","place":"神戸","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-okinawa","countries":["JPN"],"years":[1945,1945],"title":"沖縄戦","text":"地上戦の中で避難を重ねました。住民にも多くの犠牲が出ました。","source":"okinawa","place":"沖縄|那覇","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-hiroshima","countries":["JPN"],"years":[1945,1945],"title":"広島への原爆投下","text":"広島に原子爆弾が投下され、避難と救護が続く中を生きました。","source":"chronology","place":"広島","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-nagasaki","countries":["JPN"],"years":[1945,1945],"title":"長崎への原爆投下","text":"長崎に原子爆弾が投下され、避難と救護が続く中を生きました。","source":"chronology","place":"長崎","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-defeat","countries":["JPN"],"years":[1945,1945],"title":"敗戦","text":"戦争が終わったと聞き、家族の消息を確かめながら生活を立て直しました。","source":"demob","place":"","heavy":false,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-blackMarket","countries":["JPN"],"years":[1946,1948],"title":"戦後の食糧難","text":"配給だけでは足りず、買い出しや闇市の価格を気にしながら暮らしました。","source":"chronology","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-orphans","countries":["JPN"],"years":[1946,1947],"title":"戦災孤児と援護","text":"戦災で家族を失った子どもたちの保護と援護が課題になっていました。","source":"warSchool","place":"","heavy":true,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-xinhai","countries":["CHN"],"years":[1911,1912],"title":"辛亥革命と清朝の終わり","text":"革命によって清朝が終わり、中華民国が成立しました。地域では新しい秩序を探る日々が続きました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-warlords","countries":["CHN"],"years":[1916,1916],"title":"軍閥の時代","text":"軍閥が争う中で、地域を越える移動や商いが不安定になりました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-may4","countries":["CHN"],"years":[1919,1919],"title":"五四運動","text":"学生たちの抗議と新しい思想の議論が広がり、学びと社会の関係が話題になりました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":10,"maxAge":130},{"id":"P30B-north","countries":["CHN"],"years":[1926,1928],"title":"北伐と南京国民政府","text":"北伐が進み、南京に国民政府が置かれました。地域ごとの支配と生活も変わりました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-northFamine","countries":["CHN"],"years":[1928,1930],"title":"華北の飢饉","text":"干ばつと社会の混乱の中で食料が不足し、生活の場を離れました。","source":"famine","place":"河北|山西|陝西|山東|河南|北平|北京","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-manchukuo","countries":["CHN"],"years":[1931,1932],"title":"満州事変と満州国","text":"日本軍の占領が進み、翌年この地域に満州国が置かれました。","source":"chinaEarly","place":"東北|満州|瀋陽|長春|ハルビン","heavy":false,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-pingdingshan","countries":["CHN"],"years":[1932,1932],"title":"平頂山事件","text":"撫順近郊の平頂山で、日本軍が住民を集めて殺害したことを知りました。","source":"warCrimes","place":"撫順|平頂山","heavy":true,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-invasion","countries":["CHN"],"years":[1937,1937],"title":"日中戦争の拡大","text":"日本軍の侵攻で戦争が広がり、住まいを離れる人が増えました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-nanjing","countries":["CHN"],"years":[1937,1938],"title":"南京事件","text":"南京占領に伴い、日本軍が捕虜や住民を殺害し、性暴力や略奪を行いました。身の安全を求めて避難しました。","source":"nanjingTribunal","place":"南京|Nanjing","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-river","countries":["CHN"],"years":[1938,1938],"title":"黄河の決壊","text":"国民政府側が日本軍の進軍を止めるため堤防を決壊させました。洪水で暮らしの場を離れました。","source":"flood","place":"河南|安徽|江蘇|鄭州","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-chongqing","countries":["CHN"],"years":[1938,1943],"title":"重慶への空襲","text":"日本軍の空襲から身を守りながら、避難先で仕事と食料を探しました。","source":"warCrimes","place":"重慶","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-sanko","countries":["CHN"],"years":[1940,1942],"title":"華北の掃討作戦","text":"日本軍の掃討作戦で集落の破壊や住民の殺害が起き、避難を余儀なくされました。","source":"warCrimes","place":"河北|山西|山東|北京|北平","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-bacteria","countries":["CHN"],"years":[1940,1941],"title":"細菌戦の被害","text":"日本軍による寧波や常徳などへの細菌攻撃が行われました。感染と生活への影響が広がりました。","source":"warCrimes","place":"寧波|常徳","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-henan","countries":["CHN"],"years":[1942,1943],"title":"河南の飢饉","text":"干ばつに戦争と徴発が重なり、食料を求めて避難しました。","source":"famine","place":"河南|鄭州","heavy":true,"kind":"displace","minAge":0,"maxAge":130},{"id":"P30B-forcedLabour","countries":["CHN"],"years":[1943,1945],"title":"日本への強制労働","text":"日本へ連行され、鉱山や工事現場などで強制的に働かされました。","source":"warCrimes","place":"","heavy":true,"kind":"forcedLabour","minAge":15,"maxAge":60,"affected":40000},{"id":"P30B-civilWar","countries":["CHN"],"years":[1946,1949],"title":"国共内戦","text":"国民党と共産党の内戦が広がり、徴兵や物資の徴発、避難が生活に及びました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-prc","countries":["CHN"],"years":[1949,1949],"title":"中華人民共和国の成立","text":"中華人民共和国が成立し、大陸と台湾で異なる政治体制が続くことになりました。","source":"chinaEarly","place":"","heavy":false,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-land","countries":["CHN"],"years":[1900,1949],"title":"農村の土地と暮らし","text":"地主から土地を借り、小作料と家の食料をやりくりする農家も多くありました。","source":"chinaEarly","place":"","heavy":false,"kind":"rural","minAge":15,"maxAge":130},{"id":"P30B-foot","countries":["CHN"],"years":[1912,1912],"title":"纏足をやめる動き","text":"纏足をやめようとする動きが広がりましたが、なくなる時期には地域差がありました。","source":"foot","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-korea1919","countries":["KOR","PRK"],"years":[1919,1919],"title":"三・一運動と弾圧","text":"独立を求める運動が広がり、日本の統治当局が弾圧しました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-kominka","countries":["KOR","PRK","TWN"],"years":[1937,1939],"title":"皇民化政策","text":"日本語の使用や神社参拝などが強く求められ、家庭と学校の言葉や習慣にも統治の影響が及びました。","source":"warCrimes","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-names","countries":["KOR","PRK"],"years":[1940,1940],"title":"創氏改名","text":"創氏の制度が実施され、姓名をめぐる圧力が暮らしに入り込みました。出生時の名前と、制度の下で使う氏名は区別されました。","source":"koreaNames","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-taiwanNames","countries":["TWN"],"years":[1940,1940],"title":"改姓名の制度","text":"日本式の姓名への変更を認める制度が始まりました。申請と審査を伴い、すべての人が改姓名したわけではありません。","source":"taiwanNames","place":"","heavy":false,"kind":"record","minAge":6,"maxAge":130},{"id":"P30B-colonialLabour","countries":["KOR","PRK","TWN"],"years":[1944,1945],"title":"植民地からの労働動員","text":"戦時の労働動員が強まり、地域から日本の工場や鉱山へ送られる人もいました。","source":"warCrimes","place":"","heavy":false,"kind":"record","minAge":12,"maxAge":130},{"id":"P30B-comfort","countries":["KOR","PRK","TWN","CHN"],"years":[1940,1940],"title":"軍の慰安婦制度","text":"日本軍の関与した慰安婦制度の下で、多くの女性が自由を奪われ、性暴力を受けました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":12,"maxAge":130},{"id":"P30B-228","countries":["TWN"],"years":[1947,1947],"title":"二・二八事件","text":"抗議の広がりに対して国民党政権が軍隊を送り、住民が殺害・拘束されました。","source":"taiwan","place":"","heavy":true,"kind":"record","minAge":0,"maxAge":130},{"id":"P30B-whiteTerror","countries":["TWN"],"years":[1949,1949],"title":"戒厳と白色テロ","text":"戒厳下で政治的な取り締まりが強まり、言葉と交友関係にも慎重になりました。","source":"taiwan","place":"","heavy":true,"kind":"record","minAge":12,"maxAge":130},{"id":"P30B-unit731","countries":["JPN"],"years":[1949,1949],"title":"731部隊と細菌戦の裁判","text":"ハルビン近郊の731部隊などによる人体実験と細菌戦が、ソ連のハバロフスク裁判で問われました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-nanjingAccount","countries":["JPN"],"years":[1946,1946],"title":"南京事件の追及","text":"南京で日本軍が行った捕虜・住民の殺害や性暴力が戦争犯罪として問われました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-sookAccount","countries":["JPN"],"years":[1947,1947],"title":"シンガポールの華僑粛清の裁判","text":"1942年、日本軍がシンガポールの華人住民を選別し殺害した事件が裁判で問われました。","source":"sook","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-bataanAccount","countries":["JPN"],"years":[1946,1946],"title":"バターン死の行進","text":"1942年、フィリピンで捕虜となった兵士たちが移送中に殺害や虐待を受けた事件が、裁判で問われました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-railwayAccount","countries":["JPN"],"years":[1946,1946],"title":"泰緬鉄道の建設と強制労働","text":"日本軍が捕虜とアジアの労働者を鉄道建設に動員し、多くの命が失われたことを知りました。","source":"railway","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-manilaAccount","countries":["JPN"],"years":[1946,1946],"title":"マニラでの住民虐殺","text":"1945年のマニラ市街戦で、日本軍が多くの住民を殺害したことが問われました。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":15,"maxAge":130},{"id":"P30B-tokyoTrial","countries":["JPN"],"years":[1946,1948],"title":"東京裁判","text":"国の指導者らが平和に対する罪などで裁かれました。一般の兵士のBC級裁判とは別の法廷でした。","source":"warCrimes","place":"","heavy":true,"kind":"record","minAge":12,"maxAge":130},{"id":"P30B-settlers","countries":["JPN"],"years":[1945,1945],"title":"満蒙開拓団と残留邦人","text":"満州の開拓団などが敗戦時の避難で困難に直面し、家族と離れて中国に残る子どもや女性もいました。","source":"manchuria","place":"","heavy":true,"kind":"record","minAge":10,"maxAge":130}],"trials":{"defendants":5700,"deathSentences":984,"life":475,"terms":2944,"acquittals":1018,"other":279,"note":"判決人数。死刑判決数は執行数ではない。法務省表、ソ連・PRC法廷は別集計。"},"reference":{"japanMilitaryDead":2120000,"chinaMilitaryDead":3500000,"siberiaInterned":575000,"siberiaDead":55000,"settlers":270000,"manchuriaCivilians":1550000,"evacuatedPupils":400000,"navalAirTokkoDead":2525,"armyAirTokkoDead":1388,"kaitenCrewDead":106,"kaitenAssociatedDead":145,"ohkaKanoyaDead":55,"note":"特攻数は国会図書館回答が示す資料の航空特攻のみ。回天・震洋等を混ぜない。"},"allocation":"出生前の史実は表示しない。地域一致は行政区をまたぐ場合がある。個人への割当は史実の件数からのモデル換算で、観測された個人確率ではない。"}